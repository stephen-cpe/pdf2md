# pdf2md — example environment.
# Copy to .env and fill in the two secrets. NEVER commit .env.
# All keys per SRS Appendix B.

# --- Ollama (two separate endpoints) ---
OLLAMA_LOCAL_URL=http://localhost:11434
OLLAMA_CLOUD_URL=https://ollama.com
OLLAMA_API_KEY=PASTE_YOUR_OLLAMA_CLOUD_KEY_HERE
AGENT_MODEL=glm-5.3-flash
OCR_MODEL=glm-ocr
EMBED_MODEL=qwen3-embedding:0.6b
AGENT_TIMEOUT_SECONDS=300
OCR_TIMEOUT_SECONDS=120
# AGENT_MAX_OUTPUT_TOKENS is optional; uncomment to cap Cloud output tokens.
# AGENT_MAX_OUTPUT_TOKENS=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://pdf2md:CHANGE_ME_APP_PASSWORD@localhost:5432/pdf2md

# --- Storage ---
CHROMA_PATH=./chroma
KEEP_WORKSPACE_ON_SUCCESS=false
MAX_CLEANUP_RETRIES=3

# --- Server ---
BIND_HOST=127.0.0.1
PORT=8000

# --- Pipeline defaults (Appendix B of SRS.md) ---
RENDER_DPI=200
ROLLING_CONTEXT_PAGES=3
COVERAGE_THRESHOLD=95
# Deterministic floor: OCR-token recall each page must meet (percent, 0=off).
COVERAGE_FLOOR_TOKENS=80
# OCR references with fewer tokens than this are unmeasurable (never gated).
COVERAGE_FLOOR_MIN_OCR_TOKENS=30
MAX_PAGE_RETRIES=2
MAX_PDF_MB=500
MAX_PDF_PAGES=1000
# Hybrid routing: born-digital pages try deterministic extraction first
# (pymupdf4llm) with one verifier call; objection escalates to the full
# agentic path. false = every page takes render→OCR→agent (original behavior).
HYBRID_ROUTING=false
THINKING_EFFORT_TRANSCRIBE=low
THINKING_EFFORT_QA=high
TOC_ENABLED=true
FIG_DETAILS_BLOCKS=true
